@model IReadOnlyList<deskly_ui.Models.WishlistItem>

@{
    ViewData["Title"] = "Favorilerim";
}

<section class="min-h-[calc(100vh-82px)] bg-[#F5F5F3] px-4 py-7 sm:px-6 lg:px-10">
    <div class="mx-auto w-full max-w-7xl">

        <!-- SAYFA YOLU -->
        <nav class="flex items-center gap-2 text-sm font-medium text-[#5E7387]"
             aria-label="Sayfa yolu">

            <a asp-controller="Home"
               asp-action="Index"
               class="transition hover:text-[#1E2430]">
                Ana Sayfa
            </a>

            <span aria-hidden="true">/</span>

            <span class="text-[#1E2430]">
                Favorilerim
            </span>

        </nav>

        <!-- SAYFA BAŞLIĞI -->
        <div class="mt-7 flex flex-col gap-4 border-b border-[#AAB0B7]/25 pb-5 sm:flex-row sm:items-end sm:justify-between">

            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#5E7387]">
                    Deskly Seçkisi
                </p>

                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[#1E2430] sm:text-4xl">
                    Favorilerim
                </h1>
            </div>

            <div class="flex flex-wrap items-center gap-3">

                <span class="text-sm font-medium text-[#5E7387]">
                    @Model.Count ürün
                </span>

                @if (Model.Any())
                {
                    <form asp-controller="Wishlist"
                          asp-action="Clear"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="inline-flex items-center gap-2 rounded-full border border-[#D8DEE3] bg-white px-4 py-2.5 text-sm font-semibold text-[#5E7387] transition hover:border-red-200 hover:bg-red-50 hover:text-red-500">

                            <svg class="h-4 w-4"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 aria-hidden="true">
                                <path d="M4 7h16"></path>
                                <path d="M9 7V4h6v3"></path>
                                <path d="m6 7 1 13h10l1-13"></path>
                            </svg>

                            Tümünü Temizle
                        </button>

                    </form>
                }

            </div>

        </div>

        @if (!Model.Any())
        {
            <!-- BOŞ FAVORİLER -->
            <div class="mt-8 rounded-[28px] border border-white/60 bg-white/60 px-6 py-14 text-center shadow-[0_18px_50px_rgba(30,36,48,0.07)] backdrop-blur-xl">

                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#E7EDF1] text-[#3F5F7A]">

                    <svg class="h-7 w-7"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         aria-hidden="true">
                        <path d="M12 20.5s-7-4.4-7-10.2A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 7 3.3c0 5.8-7 10.2-7 10.2Z"></path>
                    </svg>

                </div>

                <h2 class="mt-6 text-2xl font-semibold text-[#1E2430]">
                    Henüz favori ürününüz yok
                </h2>

                <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-[#5E7387]">
                    Beğendiğiniz ürünleri kalp ikonuna dokunarak favorilerinize ekleyebilirsiniz.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="mt-7 inline-flex rounded-full bg-[#1E2430] px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-[#3F5F7A]">
                    Ürünleri Keşfet
                </a>

            </div>
        }
        else
        {
            <!-- FAVORİ ÜRÜNLER -->
            <div class="mt-8 grid items-stretch gap-6 sm:grid-cols-2 xl:grid-cols-3">

                @foreach (var item in Model)
                {
                    <article class="group relative flex min-w-0 flex-col overflow-hidden rounded-[28px] border border-white/60 bg-white/75 p-4 shadow-[0_18px_50px_rgba(30,36,48,0.08)] backdrop-blur transition duration-300 hover:-translate-y-1 hover:shadow-[0_24px_65px_rgba(30,36,48,0.12)]">

                        <!-- ÜRÜN GÖRSELİ -->
                        <div class="relative h-[230px] overflow-hidden rounded-[22px] bg-[#F5F5F3]">

                            @if (item.Product.IsNew)
                            {
                                <span class="absolute left-4 top-4 z-10 rounded-full bg-[#1E2430] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-white">
                                    Yeni
                                </span>
                            }
                            else if (item.Product.IsBestSeller)
                            {
                                <span class="absolute left-4 top-4 z-10 rounded-full bg-[#3F5F7A] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-white">
                                    Çok Satan
                                </span>
                            }

                            <!-- FAVORİDEN KALDIR: DOLU KALP -->
                            <form asp-controller="Wishlist"
                                  asp-action="Remove"
                                  method="post"
                                  class="absolute right-4 top-4 z-20">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />

                                <button type="submit"
                                        title="Favorilerden kaldır"
                                        aria-label="@item.Product.Name ürününü favorilerden kaldır"
                                        class="flex h-10 w-10 items-center justify-center rounded-full border border-white/70 bg-white text-[#1E2430] shadow-md transition hover:scale-105 hover:bg-red-50 hover:text-red-500">

                                    <svg class="h-5 w-5"
                                         viewBox="0 0 24 24"
                                         fill="currentColor"
                                         stroke="currentColor"
                                         stroke-width="1.5"
                                         aria-hidden="true">
                                        <path d="M12 20.5s-7-4.4-7-10.2A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 7 3.3c0 5.8-7 10.2-7 10.2Z"></path>
                                    </svg>

                                </button>

                            </form>

                            <a asp-controller="Products"
                               asp-action="Detail"
                               asp-route-id="@item.ProductId"
                               class="block h-full w-full">

                                <img src="@item.Product.ImageUrl"
                                     alt="@item.Product.Name"
                                     class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />

                            </a>

                        </div>

                        <!-- ÜRÜN BİLGİLERİ -->
                        <div class="flex flex-1 flex-col px-1 pb-1 pt-5">

                            <div class="flex items-start justify-between gap-4">

                                <div class="min-w-0">
                                    <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#5E7387]">
                                        @item.Product.Category
                                    </p>

                                    <h2 class="mt-2 text-lg font-semibold leading-6 tracking-tight text-[#1E2430]">
                                        @item.Product.Name
                                    </h2>
                                </div>

                                <div class="shrink-0 text-right">

                                    @if (item.Product.OldPrice.HasValue)
                                    {
                                        <p class="text-xs text-[#7A8794] line-through">
                                            ₺@item.Product.OldPrice.Value.ToString("N0")
                                        </p>
                                    }

                                    <p class="mt-1 text-lg font-semibold text-[#1E2430]">
                                        ₺@item.Product.Price.ToString("N0")
                                    </p>

                                </div>

                            </div>

                            <p class="mt-3 text-sm leading-6 text-[#5E7387]">
                                @item.Product.ShortDescription
                            </p>

                            @if (item.Product.Variants.Any())
                            {
                                <div class="mt-4 flex items-center gap-2">

                                    @foreach (var variant in item.Product.Variants.Take(4))
                                    {
                                        <span title="@variant.ColorName"
                                              class="h-5 w-5 rounded-full border-2 border-white shadow-sm ring-1 ring-[#AAB0B7]/45"
                                              style="background-color:@variant.ColorCode">
                                        </span>
                                    }

                                </div>
                            }

                            <div class="mt-5 flex items-center justify-between gap-4 border-t border-[#AAB0B7]/25 pt-4">

                                <a asp-controller="Products"
                                   asp-action="Detail"
                                   asp-route-id="@item.ProductId"
                                   class="inline-flex items-center gap-2 text-sm font-semibold text-[#1E2430] transition hover:text-[#3F5F7A]">

                                    Ürünü İncele
                                    <span>→</span>

                                </a>

                                <form asp-controller="Cart"
                                      asp-action="Add"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@item.ProductId" />

                                    <input type="hidden"
                                           name="quantity"
                                           value="1" />

                                    <input type="hidden"
                                           name="selectedColor"
                                           value="@(item.Product.Variants.FirstOrDefault()?.ColorName)" />

                                    <button type="submit"
                                            class="rounded-full bg-[#1E2430] px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#3F5F7A]">
                                        Sepete Ekle
                                    </button>

                                </form>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </div>
</section>