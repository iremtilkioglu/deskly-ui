@{
    ViewData["Title"] = "Hakkımızda";
}

<section class="mx-auto max-w-7xl px-6 py-16">
    <div class="max-w-3xl">
        <span class="inline-flex rounded-full border border-[#AAB0B7]/40 bg-white/70 px-4 py-2 text-xs font-medium uppercase tracking-[0.18em] text-[#4F5B66]">
            Deskly Hakkında
        </span>

        <h1 class="mt-6 text-4xl font-semibold tracking-tight text-[#1E2430] md:text-5xl">
            Modern çalışma alanları için sade ve işlevsel çözümler.
        </h1>

        <p class="mt-6 text-base leading-8 text-[#4F5B66] md:text-lg">
            Deskly; estetik, düzen ve günlük kullanım konforunu bir araya getiren
            çalışma alanı ürünleri sunan modern bir marka deneyimi olarak kurgulanmıştır.
            Bu proje, gerçek bir e-ticaret altyapısına bağlanabilecek şekilde düşünülmüş
            frontend mimarisini ve kullanıcı deneyimini öne çıkarır.
        </p>
    </div>
</section>