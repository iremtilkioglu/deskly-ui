            <!-- GRADIENT -->
            <div class="category-card-overlay pointer-events-none absolute inset-0 bg-[linear-gradient(to_top,rgba(30,36,48,0.82)_0%,rgba(30,36,48,0.30)_38%,transparent_68%)]">
            </div>

            <!-- YAZI -->
            <div class="category-card-content absolute inset-x-0 bottom-0 p-6 text-white">

                <h3 class="text-xl font-semibold">
                    Masa Lambaları
                </h3>

                <p class="mt-2 text-sm leading-6 text-white/80">
                    Doğru ışıkla daha sakin ve verimli bir çalışma atmosferi.
                </p>

