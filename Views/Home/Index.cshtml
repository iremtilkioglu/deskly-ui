<!-- ====================================================== -->
<!-- ÖNE ÇIKAN ÜRÜNLER -->
<!-- ====================================================== -->

<section id="featured-products"
         class="mx-auto max-w-7xl px-6 py-20 lg:px-10">

    <!-- BAŞLIK -->
    <div class="mb-10 text-center">

        <span class="inline-flex rounded-full border border-[#AAB0B7]/40 bg-white/60 px-4 py-2 text-xs font-medium uppercase tracking-[0.18em] text-[#5E7387]">
            Editör Seçimi
        </span>

        <h2 class="mt-6 text-3xl font-semibold tracking-tight text-[#1E2430] sm:text-4xl">
            Öne Çıkan Ürünler
        </h2>

        <p class="mx-auto mt-3 max-w-2xl text-base leading-8 text-[#5E7387]">
            Deskly koleksiyonundaki en dikkat çeken ürünleri keşfedin.
        </p>

        <a asp-controller="Products"
           asp-action="Index"
           class="mt-4 inline-flex text-sm font-semibold text-[#3F5F7A] transition hover:text-[#1E2430]">
            Tümünü Gör
        </a>

    </div>


    <!-- SLIDER -->
    <div class="featured-carousel">

        <div class="featured-carousel-viewport">

            <div class="featured-carousel-track">

                @foreach (var product in Model.FeaturedProducts)
                {
                    <div class="featured-carousel-slide">
                        @await Html.PartialAsync(
                            "Partials/_HomeProductCard",
                            product
                        )
                    </div>
                }

            </div>

        </div>


        <!-- SOL -->
        <button type="button"
                id="featuredPrev"
                class="featured-carousel-arrow featured-carousel-arrow-left"
                aria-label="Önceki ürünler">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"></path>
            </svg>

        </button>


        <!-- SAĞ -->
        <button type="button"
                id="featuredNext"
                class="featured-carousel-arrow featured-carousel-arrow-right"
                aria-label="Sonraki ürünler">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="m9 18 6-6-6-6"></path>
            </svg>

        </button>

    </div>

</section>

<!-- BLOG -->
<section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
    <div class="mb-10 text-center">
        <span class="inline-flex rounded-full border border-[#AAB0B7]/40 bg-white/60 px-4 py-2 text-xs font-medium uppercase tracking-[0.18em] text-[#5E7387]">
            İçerikler
        </span>

        <h2 class="mt-6 text-3xl font-semibold text-[#1E2430] sm:text-4xl">
            Blog
        </h2>

        <p class="mx-auto mt-3 max-w-2xl text-base leading-8 text-[#5E7387]">
            Çalışma alanı, verimlilik ve modern masa düzeni üzerine kısa içerikler.
        </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
        @foreach (var post in Model.LatestBlogPosts)
        {
            @await Html.PartialAsync("Partials/_BlogCard", post)
        }
    </div>
</section>

<!-- NEWSLETTER -->
<section class="py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
        <div class="mx-auto max-w-4xl rounded-[32px] border border-white/50 bg-[linear-gradient(135deg,_rgba(245,245,243,0.92)_0%,_rgba(215,225,232,0.88)_52%,_rgba(200,215,226,0.78)_100%)] p-8 shadow-[0_20px_60px_rgba(30,36,48,0.08)] backdrop-blur transition duration-300 hover:border-[#AAB0B7]/40 hover:shadow-[0_24px_70px_rgba(30,36,48,0.12)] sm:p-10 lg:p-12">
            <div class="mx-auto max-w-2xl text-center">
                <span class="inline-flex rounded-full border border-[#AAB0B7]/40 bg-white/60 px-4 py-2 text-xs font-medium uppercase tracking-[0.18em] text-[#5E7387]">
                    Newsletter
                </span>

                <h2 class="mt-6 text-3xl font-semibold tracking-tight text-[#1E2430] sm:text-4xl">
                    Güncel Kal
                </h2>

                <p class="mt-4 text-base leading-8 text-[#5E7387] sm:text-lg">
                    Yeni ürünler, çalışma alanı önerileri ve içerikler için e-posta listemize katıl.
                </p>
            </div>

            <div class="mx-auto mt-8 flex max-w-2xl flex-col gap-3 sm:flex-row">
                <input type="email"
                       placeholder="E-posta adresiniz"
                       class="w-full rounded-full border border-[#AAB0B7]/40 bg-white/80 px-5 py-4 text-sm text-[#1E2430] outline-none transition placeholder:text-[#7A8794] focus:border-[#3F5F7A] focus:bg-white" />

                <button class="whitespace-nowrap rounded-full bg-[#3F5F7A] px-6 py-3 text-sm font-medium text-white transition hover:bg-[#2B313C]">
                    Abone Ol
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {

    <script src="~/js/hero-slider.js"
            asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const viewport =
                document.querySelector(".featured-carousel-viewport");

            const track =
                document.querySelector(".featured-carousel-track");

            const slides =
                Array.from(
                    document.querySelectorAll(
                        ".featured-carousel-slide"
                    )
                );

            const prev =
                document.getElementById("featuredPrev");

            const next =
                document.getElementById("featuredNext");


            if (
                !viewport ||
                !track ||
                slides.length === 0 ||
                !prev ||
                !next
            ) {
                return;
            }


            let currentIndex = 0;
            let autoSlideTimer;


           const getVisibleCount = () => {

    if (window.innerWidth <= 640) {
        return 1;
    }

    if (window.innerWidth <= 900) {
        return 2;
    }

    if (window.innerWidth <= 1199) {
        return 2;
    }

    return 3;
};


            const getGap = () => {

                if (window.innerWidth <= 640) {
                    return 16;
                }

                if (window.innerWidth <= 900) {
                    return 20;
                }

                return 24;
            };


            const getMaxIndex = () => {

                return Math.max(
                    0,
                    slides.length - getVisibleCount()
                );

            };


            const updateSlider = () => {

                const slideWidth =
                    slides[0].getBoundingClientRect().width;

                const distance =
                    currentIndex *
                    (slideWidth + getGap());

                track.style.transform =
                    `translateX(-${distance}px)`;


                prev.disabled =
                    currentIndex === 0;

                next.disabled =
                    currentIndex >= getMaxIndex();

            };


            const goNext = () => {

                if (currentIndex >= getMaxIndex()) {
                    currentIndex = 0;
                }
                else {
                    currentIndex++;
                }

                updateSlider();

            };


            const goPrev = () => {

                if (currentIndex <= 0) {
                    currentIndex = getMaxIndex();
                }
                else {
                    currentIndex--;
                }

                updateSlider();

            };


            const startAutoSlide = () => {

                clearInterval(autoSlideTimer);

                autoSlideTimer =
                    setInterval(
                        goNext,
                        4000
                    );

            };


            const stopAutoSlide = () => {

                clearInterval(
                    autoSlideTimer
                );

            };


            next.addEventListener(
                "click",
                () => {
                    goNext();
                    startAutoSlide();
                }
            );


            prev.addEventListener(
                "click",
                () => {
                    goPrev();
                    startAutoSlide();
                }
            );


            viewport.addEventListener(
                "mouseenter",
                stopAutoSlide
            );


            viewport.addEventListener(
                "mouseleave",
                startAutoSlide
            );


            window.addEventListener(
                "resize",
                () => {

                    currentIndex =
                        Math.min(
                            currentIndex,
                            getMaxIndex()
                        );

                    updateSlider();

                }
            );


            updateSlider();
            startAutoSlide();

        });
    </script>

}