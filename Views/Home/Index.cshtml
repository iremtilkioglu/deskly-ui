        </a>


        <!-- =====================================================
             ORGANIZER
             ===================================================== -->

        <a href="#"
           class="group relative block overflow-hidden rounded-[30px]">

            <!-- GÖRSEL -->
            <div class="aspect-[4/5] overflow-hidden bg-[#F5F5F3]">

                <img src="/images/categories/category-organizer.png"
