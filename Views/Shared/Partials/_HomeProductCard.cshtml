@model deskly_ui.Models.Product

<article class="group flex h-[380px] flex-col rounded-[26px] border border-[#E4E8EC] bg-white px-4 pt-4 pb-6 transition duration-300 hover:-translate-y-1 hover:border-[#CAD4DC]">    <!-- ÜRÜN GÖRSELİ -->
<div class="h-[210px] shrink-0 overflow-hidden rounded-[20px] bg-[#F5F5F3]">
        <img src="@Model.ImageUrl"
             alt="@Model.Name"
             class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]" />
    </div>

    <!-- ÜRÜN BİLGİLERİ -->
    <div class="mt-4 flex min-h-0 flex-1 flex-col">

        <!-- BAŞLIK + FİYAT -->
        <div class="flex items-start justify-between gap-3">

            <h3 class="min-w-0 flex-1 text-[16px] font-semibold leading-6 text-[#1E2430]">
                @Model.Name
            </h3>

            <span class="shrink-0 whitespace-nowrap text-[15px] font-semibold text-[#1E2430]">
                ₺@Model.Price.ToString("N0")
            </span>

        </div>

        <!-- KISA AÇIKLAMA -->
        <p class="mt-2 line-clamp-2 min-h-[48px] text-sm leading-6 text-[#5E7387]">
            @Model.ShortDescription
        </p>

        <!-- İNCELE -->
        <a asp-controller="Products"
           asp-action="Detail"
           asp-route-id="@Model.Id"
           class="mt-auto inline-flex w-full items-center justify-center rounded-full border border-[#94B0C5] px-4 py-2.5 text-sm font-semibold text-[#1E2430] transition duration-200 hover:border-[#3F5F7A] hover:bg-[#3F5F7A] hover:text-white">
            İncele
        </a>

    </div>

</article>