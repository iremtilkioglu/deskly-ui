@inject deskly_ui.Services.CartService CartService
@inject deskly_ui.Services.WishlistService WishlistService

@{
    var isLoggedIn =
        Context.Session.GetString("IsLoggedIn") == "true";

    var userName =
        Context.Session.GetString("UserName") ?? "Hesabım";
}

<header id="siteHeader"
        class="sticky top-0 z-50 border-b border-white/10 bg-[#2B313C]/95 shadow-[0_8px_30px_rgba(30,36,48,0.08)] backdrop-blur-xl">

    <!-- HEADER ANA ALANI -->
    <div class="mx-auto flex min-h-[82px] max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">

        <!-- LOGO -->
      <!-- ========================================================== -->
<!-- DESKLY LOGO -->
<!-- ========================================================== -->

<a asp-controller="Home"
   asp-action="Index"
   aria-label="Deskly ana sayfa"
   class="flex shrink-0 items-center">

    <img src="/images/brand/deskly-logo-white.png"
         alt="Deskly"
         class="h-9 w-auto object-contain sm:h-10 lg:h-11" />

</a>


        <!-- ========================================================== -->
        <!-- MASAÜSTÜ MENÜ -->
        <!-- ========================================================== -->
        <nav class="hidden items-center gap-7 lg:flex"
             aria-label="Ana menü">

            <a asp-controller="Products"
               asp-action="Index"
               class="text-sm font-medium text-white/75 transition hover:text-white">
                Ürünler
            </a>

            <a asp-controller="Products"
               asp-action="Index"
               asp-fragment="productFilters"
               class="text-sm font-medium text-white/75 transition hover:text-white">
                Kategoriler
            </a>

            <a asp-controller="Products"
               asp-action="Index"
               asp-route-sort="new"
               class="text-sm font-medium text-white/75 transition hover:text-white">
                Yeni Gelenler
            </a>

           <!-- MASANI TASARLA -->
<a asp-controller="Configurator"
   asp-action="Index"
   class="text-sm font-medium text-white/75 transition hover:text-white">
    Masanı Tasarla
</a>

        </nav>


        <!-- ========================================================== -->
        <!-- SAĞ AKSİYONLAR -->
        <!-- ========================================================== -->
        <div class="flex shrink-0 items-center gap-2 sm:gap-3">

            <!-- MASAÜSTÜ ARAMA -->
            <button type="button"
                    aria-label="Ürün ara"
                    class="hidden h-11 items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-4 text-sm font-medium text-white/80 transition hover:border-white/25 hover:bg-white/10 hover:text-white lg:inline-flex">

                <svg class="h-[18px] w-[18px]"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-3.8-3.8"></path>
                </svg>

                <span class="hidden xl:inline">
                    Ara
                </span>

            </button>


            <!-- ====================================================== -->
            <!-- MASAÜSTÜ HESAP -->
            <!-- ====================================================== -->

            @if (isLoggedIn)
            {
                <a asp-controller="Account"
                   asp-action="Profile"
                   aria-label="Hesabım"
                   class="hidden h-11 items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-4 text-sm font-medium text-white/80 transition hover:border-white/25 hover:bg-white/10 hover:text-white lg:inline-flex">

                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/15 text-[11px] font-semibold text-white">
                        İT
                    </span>

                    <span class="hidden xl:inline">
                        @userName
                    </span>

                </a>

                <a asp-controller="Account"
                   asp-action="Logout"
                   aria-label="Çıkış yap"
                   title="Çıkış yap"
                   class="hidden h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/[0.04] text-white/80 transition hover:border-red-300/30 hover:bg-red-500/10 hover:text-red-200 lg:inline-flex">

                    <svg class="h-[18px] w-[18px]"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M10 17l5-5-5-5"></path>
                        <path d="M15 12H3"></path>
                        <path d="M14 4h6v16h-6"></path>
                    </svg>

                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   aria-label="Giriş yap"
                   class="hidden h-11 items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-4 text-sm font-medium text-white/80 transition hover:border-white/25 hover:bg-white/10 hover:text-white lg:inline-flex">

                    <svg class="h-[18px] w-[18px]"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path>
                    </svg>

                    <span class="hidden xl:inline">
                        Giriş Yap
                    </span>

                </a>
            }


            <!-- FAVORİLER -->
            <a asp-controller="Wishlist"
               asp-action="Index"
               aria-label="Favorilerim"
               class="relative inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/[0.04] text-white/80 transition hover:border-white/25 hover:bg-white/10 hover:text-white">

                <svg class="h-5 w-5"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M12 20.5s-7-4.4-7-10.2A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 7 3.3c0 5.8-7 10.2-7 10.2Z"></path>
                </svg>

                <span class="wishlist-count-badge absolute -right-1.5 -top-2 flex h-5 min-w-[20px] items-center justify-center rounded-full border-2 border-[#2B313C] bg-white px-1 text-[10px] font-bold leading-none text-[#1E2430] shadow-sm @(WishlistService.GetCount() == 0 ? "hidden" : "")">
                    @WishlistService.GetCount()
                </span>

            </a>


            <!-- SEPET -->
            <a asp-controller="Cart"
               asp-action="Index"
               aria-label="Sepetim"
               class="inline-flex h-11 items-center gap-2 rounded-full bg-white px-3.5 text-sm font-semibold text-[#2B313C] shadow-sm transition hover:bg-white/90 sm:px-5">

                <svg class="h-[18px] w-[18px] sm:hidden"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L20 8H6"></path>
                    <circle cx="10" cy="20" r="1"></circle>
                    <circle cx="17" cy="20" r="1"></circle>
                </svg>

                <span class="hidden sm:inline">
                    Sepet
                </span>

                <span>
                    (@CartService.GetTotalQuantity())
                </span>

            </a>


            <!-- TABLET / MOBİL HAMBURGER -->
            <button type="button"
                    id="mobileMenuButton"
                    aria-label="Menüyü aç"
                    aria-expanded="false"
                    aria-controls="mobileMenu"
                    class="relative inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/[0.04] text-white/85 transition hover:border-white/25 hover:bg-white/10 hover:text-white lg:hidden">

                <svg id="menuOpenIcon"
                     class="h-5 w-5"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     aria-hidden="true">
                    <path d="M4 7h16"></path>
                    <path d="M4 12h16"></path>
                    <path d="M4 17h16"></path>
                </svg>

                <svg id="menuCloseIcon"
                     class="hidden h-5 w-5"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     aria-hidden="true">
                    <path d="M6 6l12 12"></path>
                    <path d="M18 6 6 18"></path>
                </svg>

            </button>

        </div>

    </div>


    <!-- ========================================================== -->
    <!-- TABLET / MOBİL AÇILIR MENÜ -->
    <!-- ========================================================== -->

    <div id="mobileMenu"
         class="invisible max-h-0 overflow-hidden border-t border-white/0 bg-[#2B313C]/98 opacity-0 transition-all duration-300 ease-out lg:hidden">

        <div class="mx-auto max-w-7xl px-4 pb-5 pt-3 sm:px-6">


            <!-- MOBİL ARAMA -->
            <div class="relative mb-4">

                <svg class="pointer-events-none absolute left-4 top-1/2 h-[18px] w-[18px] -translate-y-1/2 text-white/45"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-3.8-3.8"></path>
                </svg>

                <input type="search"
                       placeholder="Ürün ara..."
                       aria-label="Ürün ara"
                       class="h-12 w-full rounded-full border border-white/15 bg-white/[0.06] pl-11 pr-4 text-sm text-white outline-none transition placeholder:text-white/40 focus:border-white/30 focus:bg-white/10" />

            </div>


            <!-- ====================================================== -->
            <!-- MOBİL ANA MENÜ -->
            <!-- ====================================================== -->

            <nav class="space-y-1"
                 aria-label="Mobil menü">


                <!-- ÜRÜNLER -->
                <a asp-controller="Products"
                   asp-action="Index"
                   class="mobile-menu-link flex items-center justify-between rounded-2xl px-4 py-3.5 text-sm font-medium text-white/80 transition hover:bg-white/[0.07] hover:text-white">

                    <span>Ürünler</span>

                    <svg class="h-4 w-4 text-white/35"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>

                </a>


                <!-- KATEGORİLER -->
                <a asp-controller="Products"
                   asp-action="Index"
                   asp-fragment="productFilters"
                   class="mobile-menu-link flex items-center justify-between rounded-2xl px-4 py-3.5 text-sm font-medium text-white/80 transition hover:bg-white/[0.07] hover:text-white">

                    <span>Kategoriler</span>

                    <svg class="h-4 w-4 text-white/35"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>

                </a>


                <!-- YENİ GELENLER -->
                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-sort="new"
                   class="mobile-menu-link flex items-center justify-between rounded-2xl px-4 py-3.5 text-sm font-medium text-white/80 transition hover:bg-white/[0.07] hover:text-white">

                    <span>Yeni Gelenler</span>

                    <svg class="h-4 w-4 text-white/35"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>

                </a>


            <!-- MASANI TASARLA -->
<a asp-controller="Configurator"
   asp-action="Index"
   class="mobile-menu-link flex items-center justify-between rounded-2xl px-4 py-3.5 text-sm font-medium text-white/80 transition hover:bg-white/[0.07] hover:text-white">

    <span>Masanı Tasarla</span>

    <svg class="h-4 w-4 text-white/35"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="1.8"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">
        <path d="m9 18 6-6-6-6"></path>
    </svg>

</a>

            </nav>


            <!-- ====================================================== -->
            <!-- MOBİL ALT AKSİYONLAR -->
            <!-- ====================================================== -->

            <div class="mt-4 grid gap-3 border-t border-white/10 pt-4 sm:grid-cols-2">

                @if (isLoggedIn)
                {
                    <a asp-controller="Account"
                       asp-action="Profile"
                       class="mobile-menu-link flex h-12 items-center justify-center gap-2 rounded-full border border-white/15 bg-white/[0.05] text-sm font-medium text-white/85 transition hover:bg-white/10 hover:text-white">

                        <svg class="h-[18px] w-[18px]"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path>
                        </svg>

                        Hesabım

                    </a>

                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="mobile-menu-link flex h-12 items-center justify-center gap-2 rounded-full border border-red-300/20 bg-red-500/[0.06] text-sm font-medium text-red-200 transition hover:bg-red-500/10">

                        <svg class="h-[18px] w-[18px]"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M10 17l5-5-5-5"></path>
                            <path d="M15 12H3"></path>
                            <path d="M14 4h6v16h-6"></path>
                        </svg>

                        Çıkış Yap

                    </a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="mobile-menu-link flex h-12 items-center justify-center gap-2 rounded-full border border-white/15 bg-white/[0.05] text-sm font-medium text-white/85 transition hover:bg-white/10 hover:text-white">

                        <svg class="h-[18px] w-[18px]"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path>
                        </svg>

                        Giriş Yap

                    </a>
                }


                <a asp-controller="Wishlist"
                   asp-action="Index"
                   class="mobile-menu-link relative flex h-12 items-center justify-center gap-2 rounded-full border border-white/15 bg-white/[0.05] text-sm font-medium text-white/85 transition hover:bg-white/10 hover:text-white">

                    <svg class="h-[18px] w-[18px]"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">
                        <path d="M12 20.5s-7-4.4-7-10.2A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 7 3.3c0 5.8-7 10.2-7 10.2Z"></path>
                    </svg>

                    Favoriler

                    <span class="wishlist-count-badge absolute -right-1.5 -top-2 flex h-5 min-w-[20px] items-center justify-center rounded-full border-2 border-[#2B313C] bg-white px-1 text-[10px] font-bold leading-none text-[#1E2430] shadow-sm @(WishlistService.GetCount() == 0 ? "hidden" : "")">
                        @WishlistService.GetCount()
                    </span>

                </a>

            </div>

        </div>

    </div>

</header>


<script>
    document.addEventListener("DOMContentLoaded", () => {

        const menuButton =
            document.getElementById("mobileMenuButton");

        const mobileMenu =
            document.getElementById("mobileMenu");

        const openIcon =
            document.getElementById("menuOpenIcon");

        const closeIcon =
            document.getElementById("menuCloseIcon");

        const mobileMenuLinks =
            document.querySelectorAll(".mobile-menu-link");


        if (!menuButton || !mobileMenu) {
            return;
        }


        const openMenu = () => {

            mobileMenu.classList.remove(
                "invisible",
                "max-h-0",
                "opacity-0",
                "border-white/0"
            );

            mobileMenu.classList.add(
                "visible",
                "max-h-[720px]",
                "opacity-100",
                "border-white/10"
            );

            openIcon?.classList.add("hidden");

            closeIcon?.classList.remove("hidden");

            menuButton.setAttribute(
                "aria-expanded",
                "true"
            );

            menuButton.setAttribute(
                "aria-label",
                "Menüyü kapat"
            );

        };


        const closeMenu = () => {

            mobileMenu.classList.remove(
                "visible",
                "max-h-[720px]",
                "opacity-100",
                "border-white/10"
            );

            mobileMenu.classList.add(
                "invisible",
                "max-h-0",
                "opacity-0",
                "border-white/0"
            );

            closeIcon?.classList.add("hidden");

            openIcon?.classList.remove("hidden");

            menuButton.setAttribute(
                "aria-expanded",
                "false"
            );

            menuButton.setAttribute(
                "aria-label",
                "Menüyü aç"
            );

        };


        const isMenuOpen = () =>
            menuButton.getAttribute(
                "aria-expanded"
            ) === "true";


        menuButton.addEventListener(
            "click",
            (event) => {

                event.stopPropagation();

                if (isMenuOpen()) {
                    closeMenu();
                }
                else {
                    openMenu();
                }

            }
        );


        mobileMenuLinks.forEach((link) => {

            link.addEventListener(
                "click",
                closeMenu
            );

        });


        document.addEventListener(
            "click",
            (event) => {

                if (
                    isMenuOpen() &&
                    !mobileMenu.contains(event.target) &&
                    !menuButton.contains(event.target)
                ) {
                    closeMenu();
                }

            }
        );


        document.addEventListener(
            "keydown",
            (event) => {

                if (
                    event.key === "Escape" &&
                    isMenuOpen()
                ) {

                    closeMenu();

                    menuButton.focus();

                }

            }
        );


        window.addEventListener(
            "resize",
            () => {

                if (window.innerWidth >= 1024) {
                    closeMenu();
                }

            }
        );

    });
</script>