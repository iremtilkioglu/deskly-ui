@model deskly_ui.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<section class="min-h-[calc(100vh-82px)] bg-[#F5F5F3] px-4 py-8 sm:px-6 lg:px-10">
    <div class="mx-auto grid w-full max-w-6xl overflow-hidden rounded-[32px] border border-white/60 bg-white/65 shadow-[0_24px_70px_rgba(30,36,48,0.10)] backdrop-blur-xl lg:grid-cols-[0.92fr_1.08fr]">

        <!-- SOL TANITIM ALANI -->
        <div class="relative hidden overflow-hidden bg-[#1E2430] p-10 text-white lg:flex lg:min-h-[680px] lg:flex-col lg:justify-between">

            <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/[0.04]"></div>
            <div class="absolute -bottom-28 -left-24 h-80 w-80 rounded-full bg-white/[0.04]"></div>

            <div class="relative">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="inline-flex items-center gap-3">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-lg font-semibold">
                        D
                    </div>

                    <div>
                        <span class="block text-xl font-medium">
                            Deskly
                        </span>

                        <span class="block text-sm text-white/55">
                            Çalışma alanı ürünleri
                        </span>
                    </div>

                </a>
            </div>

            <div class="relative max-w-md">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/45">
                    Hesabınıza hoş geldiniz
                </p>

                <h1 class="mt-5 text-4xl font-semibold leading-tight tracking-tight">
                    Favorilerinize, sepetinize ve siparişlerinize tek yerden ulaşın.
                </h1>

                <p class="mt-5 text-base leading-8 text-white/60">
                    Deskly hesabınızla alışveriş deneyiminizi kaldığınız yerden sürdürün.
                </p>
            </div>

            <div class="relative grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">

                <div class="rounded-[20px] border border-white/10 bg-white/[0.05] p-4">
                    <p class="text-sm font-semibold">
                        Favoriler
                    </p>

                    <p class="mt-2 text-xs leading-6 text-white/50">
                        Beğendiğiniz ürünleri saklayın.
                    </p>
                </div>

                <div class="rounded-[20px] border border-white/10 bg-white/[0.05] p-4">
                    <p class="text-sm font-semibold">
                        Hızlı ödeme
                    </p>

                    <p class="mt-2 text-xs leading-6 text-white/50">
                        Adres ve sepet bilgilerinizi yönetin.
                    </p>
                </div>

                <div class="rounded-[20px] border border-white/10 bg-white/[0.05] p-4">
                    <p class="text-sm font-semibold">
                        Sipariş takibi
                    </p>

                    <p class="mt-2 text-xs leading-6 text-white/50">
                        Sipariş geçmişinizi görüntüleyin.
                    </p>
                </div>

            </div>

        </div>

        <!-- SAĞ FORM ALANI -->
        <div class="flex min-h-[620px] items-center px-5 py-10 sm:px-10 lg:px-14">

            <div class="mx-auto w-full max-w-md">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="inline-flex items-center gap-2 text-sm font-medium text-[#5E7387] transition hover:text-[#1E2430]">
                    <span>←</span>
                    Ana sayfaya dön
                </a>

                <div class="mt-8">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#5E7387]">
                        Deskly Hesap
                    </p>

                    <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#1E2430] sm:text-4xl">
                        Giriş Yap
                    </h2>

                    <p class="mt-3 text-sm leading-7 text-[#5E7387]">
                        Hesabınıza giriş yaparak alışveriş deneyiminize devam edin.
                    </p>
                </div>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      class="mt-8 space-y-5">

                    @Html.AntiForgeryToken()

                    <input asp-for="ReturnUrl"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="rounded-[18px] border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600 empty:hidden">
                    </div>

                    <!-- E-POSTA -->
                    <label class="block">
                        <span class="mb-2 block text-sm font-medium text-[#1E2430]">
                            E-posta
                        </span>

                        <input asp-for="Email"
                               type="email"
                               autocomplete="email"
                               placeholder="ornek@email.com"
                               class="h-12 w-full rounded-[18px] border border-[#AAB0B7]/35 bg-white px-4 text-sm text-[#1E2430] outline-none transition placeholder:text-[#8A949D] focus:border-[#3F5F7A] focus:ring-2 focus:ring-[#3F5F7A]/15" />

                        <span asp-validation-for="Email"
                              class="mt-2 block text-xs text-red-500">
                        </span>
                    </label>

                    <!-- ŞİFRE -->
                    <label class="block">
                        <span class="mb-2 block text-sm font-medium text-[#1E2430]">
                            Şifre
                        </span>

                        <div class="relative">
                            <input asp-for="Password"
                                   id="loginPassword"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="Şifreniz"
                                   class="h-12 w-full rounded-[18px] border border-[#AAB0B7]/35 bg-white px-4 pr-12 text-sm text-[#1E2430] outline-none transition placeholder:text-[#8A949D] focus:border-[#3F5F7A] focus:ring-2 focus:ring-[#3F5F7A]/15" />

                            <button type="button"
                                    id="toggleLoginPassword"
                                    aria-label="Şifreyi göster"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-[#5E7387] transition hover:text-[#1E2430]">

                                <svg id="loginPasswordShowIcon"
                                     class="h-5 w-5"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     aria-hidden="true">
                                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                                    <circle cx="12" cy="12" r="2.5"></circle>
                                </svg>

                                <svg id="loginPasswordHideIcon"
                                     class="hidden h-5 w-5"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     aria-hidden="true">
                                    <path d="m3 3 18 18"></path>
                                    <path d="M10.6 6.2A8.8 8.8 0 0 1 12 6c6 0 9.5 6 9.5 6a15.8 15.8 0 0 1-2.1 2.8"></path>
                                    <path d="M6.4 6.4C3.9 8 2.5 12 2.5 12s3.5 6 9.5 6a9.5 9.5 0 0 0 3.2-.5"></path>
                                </svg>

                            </button>
                        </div>

                        <span asp-validation-for="Password"
                              class="mt-2 block text-xs text-red-500">
                        </span>
                    </label>

                    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

                        <label class="inline-flex cursor-pointer items-center gap-3">
                            <input asp-for="RememberMe"
                                   type="checkbox"
                                   class="h-4 w-4 rounded border-[#AAB0B7]/40 accent-[#1E2430]" />

                            <span class="text-sm text-[#5E7387]">
                                Beni hatırla
                            </span>
                        </label>

                        <a asp-controller="Account"
                           asp-action="ForgotPassword"
                           class="text-sm font-semibold text-[#3F5F7A] transition hover:text-[#1E2430]">
                            Şifremi unuttum
                        </a>

                    </div>

                    <button type="submit"
                            class="flex w-full items-center justify-center rounded-full bg-[#1E2430] px-6 py-4 text-base font-semibold text-white transition hover:bg-[#3F5F7A]">
                        Giriş Yap
                    </button>

                </form>

                <div class="mt-7 border-t border-[#AAB0B7]/25 pt-6 text-center">

                    <p class="text-sm text-[#5E7387]">
                        Henüz hesabınız yok mu?

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="ml-1 font-semibold text-[#1E2430] transition hover:text-[#3F5F7A]">
                            Hesap Oluştur
                        </a>
                    </p>

                </div>

                <div class="mt-5 rounded-[18px] border border-[#AAB0B7]/20 bg-white/55 px-4 py-3">

                    <p class="text-xs leading-6 text-[#5E7387]">
                        Bu giriş ekranı portfolyo demosudur. Gerçek kullanıcı doğrulaması ASP.NET Core Identity entegrasyonu ile bağlanacaktır.
                    </p>

                </div>

            </div>

        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const passwordInput =
                document.getElementById("loginPassword");

            const toggleButton =
                document.getElementById("toggleLoginPassword");

            const showIcon =
                document.getElementById("loginPasswordShowIcon");

            const hideIcon =
                document.getElementById("loginPasswordHideIcon");

            toggleButton?.addEventListener("click", () => {
                if (!passwordInput) {
                    return;
                }

                const isPassword =
                    passwordInput.type === "password";

                passwordInput.type =
                    isPassword ? "text" : "password";

                showIcon?.classList.toggle("hidden", isPassword);
                hideIcon?.classList.toggle("hidden", !isPassword);

                toggleButton.setAttribute(
                    "aria-label",
                    isPassword
                        ? "Şifreyi gizle"
                        : "Şifreyi göster"
                );
            });
        });
    </script>
}