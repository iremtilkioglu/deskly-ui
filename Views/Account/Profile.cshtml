@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const menuItems = Array.from(
                document.querySelectorAll(".profile-menu-item")
            );

            const panels = Array.from(
                document.querySelectorAll(".profile-panel")
            );

            const activateTab = (tabName) => {
                menuItems.forEach((menuItem) => {
                    const isActive =
                        menuItem.dataset.profileTab === tabName;

                    menuItem.classList.toggle(
                        "bg-[#1E2430]",
                        isActive
                    );

                    menuItem.classList.toggle(
                        "text-white",
                        isActive
                    );

                    menuItem.classList.toggle(
                        "font-semibold",
                        isActive
                    );

                    menuItem.classList.toggle(
                        "text-[#5E7387]",
                        !isActive
                    );

                    menuItem.classList.toggle(
                        "font-medium",
                        !isActive
                    );

                    menuItem.setAttribute(
                        "aria-pressed",
                        isActive.toString()
                    );
                });

                panels.forEach((panel) => {
                    const isActive =
                        panel.dataset.profilePanel === tabName;

                    panel.classList.toggle(
                        "hidden",
                        !isActive
                    );
                });

                window.history.replaceState(
                    null,
                    "",
                    `#${tabName}`
                );
            };

            menuItems.forEach((menuItem) => {
                menuItem.addEventListener("click", () => {
                    activateTab(
                        menuItem.dataset.profileTab
                    );
                });
            });

            const requestedTab =
                window.location.hash.replace("#", "");

            const availableTabs = menuItems.map(
                (menuItem) => menuItem.dataset.profileTab
            );

            if (availableTabs.includes(requestedTab)) {
                activateTab(requestedTab);
            } else {
                activateTab("profile");
            }
        });
    </script>
}