@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<section class="min-h-[calc(100vh-82px)] bg-[#F5F5F3] px-4 py-8 sm:px-6 lg:px-10">
    <div class="mx-auto grid w-full max-w-6xl overflow-hidden rounded-[32px] border border-white/60 bg-white/65 shadow-[0_24px_70px_rgba(30,36,48,0.10)] backdrop-blur-xl lg:grid-cols-[0.92fr_1.08fr]">

        <!-- SOL TANITIM ALANI -->
        <div class="relative hidden overflow-hidden bg-[#1E2430] p-10 text-white lg:flex lg:min-h-[620px] lg:flex-col lg:justify-between">

            <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/[0.04]"></div>
            <div class="absolute -bottom-28 -left-24 h-80 w-80 rounded-full bg-white/[0.04]"></div>

            <div class="relative">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="inline-flex items-center gap-3">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-lg font-semibold">
                        D
                    </div>

                    <div>
                        <span class="block text-xl font-medium">
                            Deskly
                        </span>

                        <span class="block text-sm text-white/55">
                            Çalışma alanı ürünleri
                        </span>
                    </div>

                </a>
            </div>

            <div class="relative max-w-md">

                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/45">
                    Hesap kurtarma
                </p>

                <h1 class="mt-5 text-4xl font-semibold leading-tight tracking-tight">
                    Hesabınıza yeniden ulaşmanız için buradayız.
                </h1>

                <p class="mt-5 text-base leading-8 text-white/60">
                    E-posta adresinizi girin. Şifre yenileme bağlantısını size gönderelim.
                </p>

            </div>

            <div class="relative rounded-[22px] border border-white/10 bg-white/[0.05] p-5">

                <p class="text-sm font-semibold">
                    Güvenli hesap işlemleri
                </p>

                <p class="mt-2 text-xs leading-6 text-white/50">
                    Şifre yenileme bağlantısı yalnızca kayıtlı e-posta adresinize gönderilir.
                </p>

            </div>

        </div>

        <!-- SAĞ FORM ALANI -->
        <div class="flex min-h-[560px] items-center px-5 py-10 sm:px-10 lg:px-14">

            <div class="mx-auto w-full max-w-md">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="inline-flex items-center gap-2 text-sm font-medium text-[#5E7387] transition hover:text-[#1E2430]">
                    <span>←</span>
                    Giriş sayfasına dön
                </a>

                <div class="mt-8">

                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#5E7387]">
                        Deskly Hesap
                    </p>

                    <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#1E2430] sm:text-4xl">
                        Şifremi Unuttum
                    </h2>

                    <p class="mt-3 text-sm leading-7 text-[#5E7387]">
                        Hesabınıza kayıtlı e-posta adresini girin. Size şifre yenileme bağlantısı gönderelim.
                    </p>

                </div>

                <form asp-controller="Account"
                      asp-action="ForgotPassword"
                      method="post"
                      class="mt-8 space-y-5">

                    @Html.AntiForgeryToken()

                    <label class="block">

                        <span class="mb-2 block text-sm font-medium text-[#1E2430]">
                            E-posta
                        </span>

                        <input type="email"
                               name="email"
                               autocomplete="email"
                               required
                               placeholder="ornek@email.com"
                               class="h-12 w-full rounded-[18px] border border-[#AAB0B7]/35 bg-white px-4 text-sm text-[#1E2430] outline-none transition placeholder:text-[#8A949D] focus:border-[#3F5F7A] focus:ring-2 focus:ring-[#3F5F7A]/15" />

                    </label>

                    <button type="submit"
                            class="flex w-full items-center justify-center rounded-full bg-[#1E2430] px-6 py-4 text-base font-semibold text-white transition hover:bg-[#3F5F7A]">
                        Yenileme Bağlantısı Gönder
                    </button>

                </form>

                <div class="mt-7 border-t border-[#AAB0B7]/25 pt-6 text-center">

                    <p class="text-sm text-[#5E7387]">
                        Şifrenizi hatırladınız mı?

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="ml-1 font-semibold text-[#1E2430] transition hover:text-[#3F5F7A]">
                            Giriş Yap
                        </a>
                    </p>

                </div>

            </div>

        </div>

    </div>
</section>