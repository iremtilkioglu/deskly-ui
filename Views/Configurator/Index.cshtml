                         alt="Masa"
                         class="pointer-events-none absolute inset-0 z-10 h-full w-full object-contain transition-opacity duration-200" />


                    <!-- MOUSE PAD -->
                    <img id="mousepadLayer"
                         src="/images/configurator/mousepad-black.png"
                         alt="Mouse Pad"
                         draggable="false"
                         data-product-name="Mouse Pad"
                         class="configurator-product absolute left-[28%] top-[15%] z-20 hidden w-[45%] object-contain" />


                    <!-- HEADPHONE STAND -->
                    <img id="headphoneStandLayer"
                         src="/images/configurator/Headphone-Stand-(Black).png"
                         alt="Headphone Stand"
                         draggable="false"
                         data-product-name="Headphone Stand"
                         class="configurator-product absolute left-[11%] top-[19%] z-30 hidden w-[18%] object-contain" />


