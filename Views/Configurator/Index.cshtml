                                        data-color-name="Bej"
                                        data-color-label="organizerColorName"
                                        data-image="/images/configurator/Deskly-Organizer-(Beige).png"
                                        class="product-color-option h-7 w-7 rounded-full border-2 border-white bg-[#D4BE9A] shadow-sm ring-1 ring-[#AAB0B7]/40">
                                </button>

                                <button type="button"
                                        title="Ceviz"
                                        data-layer="organizerLayer"
                                        data-color-name="Ceviz"
                                        data-color-label="organizerColorName"
                                        data-image="/images/configurator/Deskly-Organizer-(Walnut).png"
                                        class="product-color-option h-7 w-7 rounded-full border-2 border-white bg-[#855038] shadow-sm ring-1 ring-[#AAB0B7]/40">
                                </button>

                            </div>

                        </div>


                        <!-- ================================================== -->
                        <!-- HEADPHONE STAND -->
                        <!-- ================================================== -->
                        <div class="rounded-[18px] border border-[#AAB0B7]/25 bg-white/60 px-4 py-3.5">

                            <div class="flex items-center justify-between gap-4">

                                <div>
                                    <h3 class="text-sm font-semibold text-[#1E2430]">
                                        Headphone Stand
                                    </h3>

                                    <p id="headphoneColorName"
                                       class="mt-1 text-xs text-[#5E7387]">
                                        Siyah
                                    </p>
                                </div>

                                <label class="relative inline-flex cursor-pointer items-center">

                                    <input id="headphoneStandToggle"
                                           type="checkbox"
                                           class="peer sr-only" />

                                    <div class="h-7 w-12 rounded-full bg-[#D8DEE3] transition peer-checked:bg-[#1E2430]"></div>

                                    <div class="absolute left-1 top-1 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></div>

                                </label>

                            </div>

                            <div class="mt-3 flex items-center gap-2">

                                <button type="button"
                                        title="Siyah"
                                        data-layer="headphoneStandLayer"
                                        data-color-name="Siyah"
                                        data-color-label="headphoneColorName"
                                        data-image="/images/configurator/Headphone-Stand-(Black).png"
                                        class="product-color-option h-7 w-7 rounded-full border-2 border-[#1E2430] bg-[#25272A] shadow-sm ring-1 ring-[#AAB0B7]/40">
                                </button>

                                <button type="button"
                                        title="Beyaz"
                                        data-layer="headphoneStandLayer"
                                        data-color-name="Beyaz"
                                        data-color-label="headphoneColorName"
                                        data-image="/images/configurator/Headphone-Stand-(White).png"
                                        class="product-color-option h-7 w-7 rounded-full border-2 border-white bg-[#F3F1EB] shadow-sm ring-1 ring-[#AAB0B7]/50">
                                </button>

                                <button type="button"
                                        title="Ceviz"
                                        data-layer="headphoneStandLayer"
                                        data-color-name="Ceviz"
                                        data-color-label="headphoneColorName"
                                        data-image="/images/configurator/Headphone-Stand-(Walnut).png"
                                        class="product-color-option h-7 w-7 rounded-full border-2 border-white bg-[#855038] shadow-sm ring-1 ring-[#AAB0B7]/40">
