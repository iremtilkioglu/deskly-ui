                                </button>

                                <button type="button"
                                        title="Beyaz"
                                        data-layer="lampLayer"
                                        data-color-name="Beyaz"
                                        data-color-label="lampColorName"
                                        data-image="/images/configurator/Luna-Desk-Lamp-(White).png"
                                        class="product-color-option h-7 w-7 rounded-full border-2 border-white bg-[#F3F1EB] shadow-sm ring-1 ring-[#AAB0B7]/50">
                                </button>

                                <button type="button"
                                        title="Pirinç"
                                        data-layer="lampLayer"
                                        data-color-name="Pirinç"
                                        data-color-label="lampColorName"
                                        data-image="/images/configurator/Luna-Desk-Lamp-(Brass).png"
