            <section class="rounded-[32px] border border-white/60 bg-white/65 p-4 shadow-[0_24px_70px_rgba(30,36,48,0.10)] backdrop-blur-xl sm:p-6">

                <div id="configuratorCanvas"
                     class="relative aspect-[4/3] overflow-hidden rounded-[26px] bg-[#EAF0F4]">

                    <!-- MASA -->
                    <img id="deskLayer"
