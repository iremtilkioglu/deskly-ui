                                </button>

                                <button type="button"
                                        title="Beyaz"
                                        data-layer="chargepadLayer"
                                        data-color-name="Beyaz"
                                        data-color-label="chargepadColorName"
                                        data-image="/images/configurator/ChargePad-Wireless-(White).png"
                                        class="product-color-option h-7 w-7 rounded-full border-2 border-white bg-[#F3F1EB] shadow-sm ring-1 ring-[#AAB0B7]/50">
                                </button>

                                <button type="button"
                                        title="Gri"
                                        data-layer="chargepadLayer"
                                        data-color-name="Gri"
