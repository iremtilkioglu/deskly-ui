                                </label>

                            </div>

                            <div class="mt-3 flex items-center gap-2">

                                <button type="button"
                                        title="Siyah"
                                        data-layer="chargepadLayer"
                                        data-color-name="Siyah"
                                        data-color-label="chargepadColorName"
                                        data-image="/images/configurator/ChargePad-Wireless-(Black).png"
