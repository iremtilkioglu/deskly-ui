@{
    ViewData["Title"] = "Masanı Tasarla";
}

<style>
    /* =========================================================
       CONFIGURATOR INTERACTION
       ========================================================= */

    #configuratorCanvas {
        isolation: isolate;
    }

    .configurator-product {
        cursor: zoom-in;
        user-select: none;
        -webkit-user-drag: none;

        transition:
            filter .22s ease,
            opacity .22s ease,
            transform .28s ease;
    }

    .configurator-product:hover {
        filter:
            brightness(1.07)
            drop-shadow(0 7px 10px rgba(30, 36, 48, 0.14));
    }

    .configurator-product.is-zoomed {
        z-index: 100 !important;
        transform: scale(2.4);
        cursor: zoom-out;

        filter:
            brightness(1.03)
            drop-shadow(0 18px 25px rgba(30, 36, 48, 0.18));
    }

    #configuratorCanvas.is-inspecting .configurator-product:not(.is-zoomed) {
        opacity: 0.20;
    }

    #configuratorCanvas.is-inspecting #deskLayer {
        opacity: 0.55;
    }
</style>


<section class="min-h-[calc(100vh-82px)] bg-[#F5F5F3] px-4 py-8 sm:px-6 lg:px-10">
    <div class="mx-auto max-w-7xl">

        <div class="grid items-start gap-8 lg:grid-cols-[360px_minmax(0,1fr)]">

            <!-- ====================================================== -->
            <!-- SOL KONTROL ALANI -->
            <!-- ====================================================== -->
            <aside class="rounded-[28px] border border-white/60 bg-white/70 p-6 shadow-[0_16px_45px_rgba(30,36,48,0.07)] backdrop-blur-xl lg:sticky lg:top-[106px] lg:max-h-[calc(100vh-130px)] lg:overflow-y-auto">

                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#5E7387]">
                    Deskly Configurator
                </p>

                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-[#1E2430]">
                    Masanı Tasarla
                </h1>

                <p class="mt-3 text-sm leading-7 text-[#5E7387]">
                    Masa rengini seçin ve çalışma alanınıza ürün ekleyin.
                </p>


                <!-- ================================================== -->
                <!-- MASA RENGİ -->
                <!-- ================================================== -->
                <div class="mt-8">

                    <h2 class="text-sm font-semibold text-[#1E2430]">
                        Masa rengi
                    </h2>

                    <div class="mt-4 grid grid-cols-2 gap-3">

                        <button type="button"
                                data-desk-image="/images/configurator/desk-white.png"
                                class="desk-option rounded-[18px] border-2 border-[#1E2430] bg-white px-3 py-4 text-sm font-semibold text-[#1E2430] transition">
                            Beyaz
                        </button>

                        <button type="button"
                                data-desk-image="/images/configurator/desk-black.png"
                                class="desk-option rounded-[18px] border border-[#AAB0B7]/35 bg-white px-3 py-4 text-sm font-medium text-[#5E7387] transition hover:border-[#3F5F7A]">
                            Siyah
                        </button>

                        <button type="button"
                                data-desk-image="/images/configurator/desk-oak.png"
                                class="desk-option rounded-[18px] border border-[#AAB0B7]/35 bg-white px-3 py-4 text-sm font-medium text-[#5E7387] transition hover:border-[#3F5F7A]">
                            Meşe
                        </button>

                        <button type="button"
                                data-desk-image="/images/configurator/desk-walnut.png"
                                class="desk-option rounded-[18px] border border-[#AAB0B7]/35 bg-white px-3 py-4 text-sm font-medium text-[#5E7387] transition hover:border-[#3F5F7A]">
                            Ceviz
                        </button>

                    </div>

                </div>


                <!-- ================================================== -->
                <!-- MASA ÜSTÜ ÜRÜNLERİ -->
                <!-- ================================================== -->
                <div class="mt-8 border-t border-[#AAB0B7]/25 pt-7">

                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#5E7387]">
