                    <img id="laptopStandLayer"
                         src="/images/configurator/Lift-Laptop-Stand-(Silver).png"
                         alt="Lift Laptop Stand"
                         draggable="false"
                         data-product-name="Lift Laptop Stand"
                         class="configurator-product absolute left-[32%] top-[18%] z-40 hidden w-[28%] object-contain" />


                    <!-- MOUSE -->
                    <img id="mouseLayer"
                         src="/images/configurator/flow-wireless-mouse-black.png"
                         alt="Flow Wireless Mouse"
                         draggable="false"
                         data-product-name="Flow Wireless Mouse"
                         class="configurator-product absolute left-[52%] top-[32%] z-50 hidden w-[10%] object-contain" />


                    <!-- LAMBA -->
                    <img id="lampLayer"
                         src="/images/configurator/Luna-Desk-Lamp-(Black).png"
                         alt="Luna Desk Lamp"
                         draggable="false"
                         data-product-name="Luna Desk Lamp"
                         class="configurator-product absolute left-[70%] top-[20%] z-40 hidden w-[20%] object-contain" />


                    <!-- CHARGEPAD -->
                    <img id="chargepadLayer"
                         src="/images/configurator/ChargePad-Wireless-(Black).png"
                         alt="ChargePad Wireless"
                         draggable="false"
                         data-product-name="ChargePad Wireless"
                         class="configurator-product absolute left-[66%] top-[34%] z-50 hidden w-[12%] object-contain" />

                </div>

            </section>

        </div>

    </div>
</section>


@section Scripts {

<script>
    document.addEventListener("DOMContentLoaded", () => {

        // =============================================================
        // KATMANLAR
        // =============================================================

        const deskLayer =
            document.getElementById("deskLayer");

        const mousepadLayer =
            document.getElementById("mousepadLayer");

        const mouseLayer =
            document.getElementById("mouseLayer");

        const laptopStandLayer =
            document.getElementById("laptopStandLayer");

        const organizerLayer =
            document.getElementById("organizerLayer");

        const headphoneStandLayer =
            document.getElementById("headphoneStandLayer");

        const lampLayer =
            document.getElementById("lampLayer");

        const chargepadLayer =
            document.getElementById("chargepadLayer");

        const configuratorCanvas =
            document.getElementById("configuratorCanvas");


        // =============================================================
        // TOGGLE'LAR
        // =============================================================

        const mousepadToggle =
            document.getElementById("mousepadToggle");

        const mouseToggle =
            document.getElementById("mouseToggle");

        const laptopStandToggle =
            document.getElementById("laptopStandToggle");

        const organizerToggle =
            document.getElementById("organizerToggle");

        const headphoneStandToggle =
            document.getElementById("headphoneStandToggle");

        const lampToggle =
            document.getElementById("lampToggle");

        const chargepadToggle =
            document.getElementById("chargepadToggle");


        // =============================================================
        // MASA RENKLERİ
        // =============================================================

        const deskOptions =
            document.querySelectorAll(".desk-option");

        deskOptions.forEach((button) => {

            button.addEventListener("click", () => {

                const imagePath =
                    button.dataset.deskImage;

                if (!deskLayer || !imagePath) {
                    return;
                }

                deskLayer.src = imagePath;

                deskOptions.forEach((option) => {

                    option.classList.remove(
                        "border-2",
                        "border-[#1E2430]",
                        "font-semibold",
                        "text-[#1E2430]"
                    );

                    option.classList.add(
                        "border",
                        "border-[#AAB0B7]/35",
                        "font-medium",
                        "text-[#5E7387]"
                    );

                });

                button.classList.remove(
                    "border",
                    "border-[#AAB0B7]/35",
                    "font-medium",
                    "text-[#5E7387]"
                );

                button.classList.add(
                    "border-2",
                    "border-[#1E2430]",
                    "font-semibold",
                    "text-[#1E2430]"
                );

            });

        });


        // =============================================================
        // ÜRÜN AÇ / KAPAT
        // =============================================================

        const connectToggle = (toggle, layer) => {

            if (!toggle || !layer) {
                return;
            }

            toggle.addEventListener("change", () => {

                layer.classList.toggle(
                    "hidden",
                    !toggle.checked
                );

            });

        };


        connectToggle(
            mousepadToggle,
            mousepadLayer
        );

        connectToggle(
            mouseToggle,
            mouseLayer
        );

        connectToggle(
            laptopStandToggle,
            laptopStandLayer
        );

        connectToggle(
            organizerToggle,
            organizerLayer
        );

        connectToggle(
            headphoneStandToggle,
            headphoneStandLayer
        );

        connectToggle(
            lampToggle,
            lampLayer
        );

        connectToggle(
            chargepadToggle,
            chargepadLayer
        );


        // =============================================================
        // ÜRÜN RENK DEĞİŞTİRME
        // =============================================================

        const colorOptions =
            document.querySelectorAll(".product-color-option");

        colorOptions.forEach((button) => {

            button.addEventListener("click", () => {

                const layerId =
                    button.dataset.layer;

                const imagePath =
                    button.dataset.image;

                const colorName =
                    button.dataset.colorName;

                const colorLabelId =
                    button.dataset.colorLabel;


                if (!layerId || !imagePath) {
                    return;
                }


                const layer =
                    document.getElementById(layerId);

                if (!layer) {
                    return;
                }


                layer.src = imagePath;


                if (colorLabelId) {

                    const label =
                        document.getElementById(colorLabelId);

                    if (label) {
                        label.textContent = colorName;
                    }

                }


                document
                    .querySelectorAll(
                        `.product-color-option[data-layer="${layerId}"]`
                    )
                    .forEach((option) => {

                        option.classList.remove(
                            "border-[#1E2430]"
                        );

                        option.classList.add(
                            "border-white"
                        );

                    });


                button.classList.remove(
                    "border-white"
                );

                button.classList.add(
                    "border-[#1E2430]"
                );


                let relatedToggle = null;


                switch (layerId) {

                    case "mousepadLayer":
                        relatedToggle = mousepadToggle;
                        break;

                    case "mouseLayer":
                        relatedToggle = mouseToggle;
                        break;

                    case "laptopStandLayer":
                        relatedToggle = laptopStandToggle;
                        break;

                    case "organizerLayer":
                        relatedToggle = organizerToggle;
                        break;

                    case "headphoneStandLayer":
                        relatedToggle = headphoneStandToggle;
                        break;

                    case "lampLayer":
                        relatedToggle = lampToggle;
                        break;

                    case "chargepadLayer":
                        relatedToggle = chargepadToggle;
                        break;

                }


                if (
                    relatedToggle &&
                    !relatedToggle.checked
                ) {

                    relatedToggle.checked = true;

                    layer.classList.remove(
                        "hidden"
                    );

                }

            });

        });


        // =============================================================
        // GERÇEK ÜRÜN ZOOM
        // =============================================================

        const configuratorProducts =
            document.querySelectorAll(".configurator-product");

        let zoomedProduct = null;


        const closeZoom = () => {

            if (!zoomedProduct) {
                return;
            }

            zoomedProduct.classList.remove(
                "is-zoomed"
            );

            configuratorCanvas.classList.remove(
                "is-inspecting"
            );

            zoomedProduct = null;

        };


        configuratorProducts.forEach((product) => {

            // Görsel sürüklenmesini engelle
            product.addEventListener("dragstart", (event) => {
                event.preventDefault();
            });


            product.addEventListener("click", (event) => {

                event.stopPropagation();


                // Aynı ürüne tekrar tıklandıysa kapat
                if (zoomedProduct === product) {

                    closeZoom();

                    return;
                }


                // Önceki zoom'u kapat
                if (zoomedProduct) {

                    zoomedProduct.classList.remove(
                        "is-zoomed"
                    );

                }


                product.classList.add(
                    "is-zoomed"
                );

                configuratorCanvas.classList.add(
                    "is-inspecting"
                );

                zoomedProduct = product;

            });

        });


        // Boş alana tıklandığında zoom kapanır
        configuratorCanvas.addEventListener(
            "click",
            () => {

                closeZoom();

            }
        );

    });
</script>

}